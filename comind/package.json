{
  "name": "comind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .vue,.ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .vue,.ts,.tsx,.js,.jsx --fix",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "wasm:build": "wasm-pack build crates/comind-wasm --target web --out-dir ../pkg -m no-install",
    "wasm:build:release": "wasm-pack build crates/comind-wasm --target web --out-dir ../pkg --release -m no-install"
  },
  "dependencies": {
