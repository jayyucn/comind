    "@tiptap/vue-3": "^3.22.3",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "lucide-vue-next": "^1.0.0",
    "lunr": "^2.3.9",
    "nanoid": "^5.1.11",
    "pinia": "^3.0.4",
    "sql.js": "^1.14.1",
