{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "comind",
  "version": "0.1.0",
  "identifier": "com.comind.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "comind",
        "width": 1600,
        "height": 1080,
        "center": true,
        "visible": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "publisher": "comind",
    "copyright": "© 2026 comind",
    "category": "Productivity",
    "shortDescription": "Local-first knowledge management tool",
    "longDescription": "A local-first outlining and bidirectional-linking knowledge tool.",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": null
    }
  }
}